rules_version = '2';

// HT-RVP-09 Panel de Documentación LAB – v02
// Reglas de seguridad de Cloud Firestore. Se publican en la consola de Firebase:
// Firestore Database > Reglas. Ningún dato se puede leer ni escribir sin una
// cuenta con perfil activo en la colección «usuarios».
//
// Roles: admin (Profesional SIG) · lider (Líder de Laboratorio) ·
//        analista (Analista de Laboratorio) · apoyo (Apoyo de Laboratorio)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones ----------
    function autenticado() { return request.auth != null; }
    function rutaPerfil() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function activo() {
      return autenticado() && exists(rutaPerfil()) && get(rutaPerfil()).data.activo == true;
    }
    function rol() { return get(rutaPerfil()).data.rol; }
    function esAdmin() { return activo() && rol() == 'admin'; }
    function esLider() { return activo() && rol() in ['lider', 'admin']; }
    function puedeCargar() { return activo() && rol() in ['analista', 'apoyo', 'lider', 'admin']; }
    function puedeRetirar() { return activo() && rol() in ['analista', 'lider', 'admin']; }
    function soyYo(u) { return u is map && u.uid == request.auth.uid; }
    function cambios() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function soloCambia(campos) { return cambios().hasOnly(campos); }

    // ---------- Perfiles de usuario ----------
    match /usuarios/{uid} {
      allow read: if activo() || (autenticado() && request.auth.uid == uid);
      allow create, update: if esAdmin()
        && request.resource.data.rol in ['admin', 'lider', 'analista', 'apoyo']
        && request.resource.data.activo is bool;
      allow delete: if false;            // se desactiva, no se borra
    }

    // ---------- Consecutivo de códigos LAB-DOC-#### ----------
    match /contadores/documentos {
      allow read: if activo();
      allow create: if puedeCargar() && request.resource.data.siguiente == 2;
      allow update: if puedeCargar() && request.resource.data.siguiente == resource.data.siguiente + 1;
      allow delete: if false;
    }

    // ---------- Evaluación de los ítems de la Resolución 1619 ----------
    match /items/{codigo} {
      allow read: if activo();
      allow create: if puedeCargar()
        && soyYo(request.resource.data.actualizadoPor)
        && request.resource.data.actualizadoEn == request.time
        && (esLider() || (request.resource.data.get('noAplica', false) == false
                          && request.resource.data.validacion.estado == 'sin_validar'));
      allow update: if puedeCargar()
        && soyYo(request.resource.data.actualizadoPor)
        && request.resource.data.actualizadoEn == request.time
        && (esLider() || (!cambios().hasAny(['noAplica', 'justificacionNA'])
                          && (!cambios().hasAny(['validacion'])
                              || request.resource.data.validacion.estado == 'sin_validar')));
      allow delete: if false;
    }

    // ---------- Documentos y evidencias (con versiones) ----------
    match /documentos/{id} {
      allow read: if activo();

      allow create: if puedeCargar()
        && soyYo(request.resource.data.cargadoPor)
        && request.resource.data.cargadoEn == request.time
        && request.resource.data.estado in ['vigente', 'por_clasificar']
        && request.resource.data.version is int && request.resource.data.version >= 1
        && request.resource.data.codigo is string
        && request.resource.data.archivo.sha256 is string;

      allow update: if
        // a) Una nueva versión deja la anterior como obsoleta
        (puedeCargar() && resource.data.estado == 'vigente'
          && request.resource.data.estado == 'obsoleto'
          && soloCambia(['estado', 'reemplazadoPor', 'obsoletoEn'])
          && existsAfter(/databases/$(database)/documents/documentos/$(request.resource.data.reemplazadoPor)))
        // b) Enviar a la papelera (con motivo); Apoyo no puede
        || (puedeRetirar() && resource.data.estado in ['vigente', 'por_clasificar']
          && request.resource.data.estado == 'papelera'
          && soyYo(request.resource.data.papelera.por)
          && request.resource.data.papelera.motivo is string
          && request.resource.data.papelera.motivo.size() >= 5
          && soloCambia(['estado', 'estadoAnterior', 'papelera']))
        // c) Restaurar desde la papelera: solo el administrador
        || (esAdmin() && resource.data.estado == 'papelera'
          && request.resource.data.estado == resource.data.estadoAnterior
          && soloCambia(['estado', 'restaurado']))
        // d) Clasificar un archivo migrado en la evidencia que corresponde
        || (puedeCargar() && resource.data.estado == 'por_clasificar'
          && request.resource.data.estado == 'vigente'
          && soloCambia(['estado', 'evidenciaId', 'version', 'serie', 'reemplazaA', 'clasificado']));

      allow delete: if false;            // nunca se borra: trazabilidad ISO 9001, 7.5.3
    }

    // ---------- Carpetas del repositorio ----------
    match /carpetas/{id} {
      allow read: if activo();
      allow create: if puedeCargar() && soyYo(request.resource.data.creadoPor)
        && request.resource.data.creadoEn == request.time
        && request.resource.data.estado == 'activa';
      allow update: if (puedeRetirar() && soloCambia(['estado', 'papelera'])
                         && request.resource.data.estado == 'papelera')
                    || (esAdmin() && soloCambia(['estado', 'restaurado']));
      allow delete: if false;
    }

    // ---------- Bitácora: solo se agregan registros ----------
    match /bitacora/{id} {
      allow read: if activo();
      allow create: if activo()
        && soyYo(request.resource.data.usuario)
        && request.resource.data.fecha == request.time;
      allow update, delete: if false;
    }

    // Todo lo demás, cerrado
    match /{ruta=**} {
      allow read, write: if false;
    }
  }
}
